<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChecksumDrop.Avalonia.ViewModels"
        x:Class="ChecksumDrop.Avalonia.Views.AboutWindow"
        x:DataType="vm:AboutWindowViewModel"
        Width="360"
        Height="180"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="About ChecksumDrop">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
      <TextBlock Text="{Binding AboutLine1}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding AboutLine2}" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" />
    </StackPanel>

    <Button Grid.Row="1" Content="Close" HorizontalAlignment="Center" Margin="0,16,0,0" Click="CloseButton_OnClick" />
  </Grid>
</Window>
