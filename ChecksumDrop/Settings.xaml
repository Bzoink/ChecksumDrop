<Window x:Class="ChecksumDrop.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChecksumDrop"
        mc:Ignorable="d"
        Title="Settings" Height="248" Width="500" FontSize="12" ResizeMode="NoResize" ShowInTaskbar="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
    <Window.Resources>
     </Window.Resources>
    <Grid Width="500" Height="247">
        <Label Content="Hash method" FontSize="24" HorizontalAlignment="Left" Height="37" Margin="42,11,0,0" VerticalAlignment="Top" Width="204" Padding="0,5,5,5" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom" />
        <RadioButton x:Name="CRC32" Content="CRC32" FontSize="18" HorizontalAlignment="Left" Margin="42,53,0,0" VerticalAlignment="Top" Checked="method_Checked" GroupName="Method" VerticalContentAlignment="Center" />
        <RadioButton x:Name="MD5" Content="MD5" FontSize="18" HorizontalAlignment="Left" Margin="42,82,0,0" VerticalAlignment="Top" Checked="method_Checked" GroupName="Method" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        <RadioButton x:Name="SHA1" Content="SHA1" FontSize="18" HorizontalAlignment="Left" Margin="42,0,0,0" VerticalAlignment="Center" Checked="method_Checked" GroupName="Method" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        <RadioButton x:Name="SHA256" Content="SHA256" FontSize="18" HorizontalAlignment="Left" Margin="188,53,0,0" VerticalAlignment="Top" Checked="method_Checked" GroupName="Method" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        <RadioButton x:Name="SHA384" Content="SHA384" FontSize="18" HorizontalAlignment="Left" Margin="188,82,0,0" VerticalAlignment="Top" Checked="method_Checked" GroupName="Method" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        <RadioButton x:Name="SHA512" Content="SHA512" FontSize="18" HorizontalAlignment="Left" Margin="188,0,0,0" VerticalAlignment="Center" Checked="method_Checked" GroupName="Method" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        <RadioButton x:Name="SHA3256" Content="SHA3-256" FontSize="18" HorizontalAlignment="Left" Margin="334,53,0,0" VerticalAlignment="Top" Checked="method_Checked" GroupName="Method" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        <RadioButton x:Name="SHA3384" Content="SHA3-384" FontSize="18" HorizontalAlignment="Left" Margin="334,82,0,0" VerticalAlignment="Top" Checked="method_Checked" GroupName="Method" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        <RadioButton x:Name="SHA3512" Content="SHA3-512" FontSize="18" HorizontalAlignment="Left" Margin="334,0,0,0" VerticalAlignment="Center" Checked="method_Checked" GroupName="Method" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
        <Label x:Name="About1" Content="" HorizontalAlignment="Center" Margin="0,149,0,0" VerticalAlignment="Top" Width="416"/>
        <Label x:Name="About2" Content="" HorizontalAlignment="Center" Margin="0,175,0,0" VerticalAlignment="Top" Width="416"/>
    </Grid>
</Window>
